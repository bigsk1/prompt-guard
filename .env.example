# Copy to .env and set a random key of at least 16 characters:
#   openssl rand -hex 32
PROMPT_GUARD_API_KEY=

# Host port published by Compose. Use 127.0.0.1:8080 behind a TLS proxy.
PROMPT_GUARD_PUBLISH=0.0.0.0:8080

# Caller-facing default when a request omits threshold. 0.5 matches the
# model card for untrusted tool output. Raise it when false alarms are costly.
PROMPT_GUARD_DEFAULT_THRESHOLD=0.5

# Optional YAML file. Environment variables override it.
# PROMPT_GUARD_CONFIG=/config/config.yaml

# ONNX artifact used by the CPU image: quantized or fp32.
PROMPT_GUARD_ONNX_VARIANT=quantized

PROMPT_GUARD_WINDOW_SIZE=2048
PROMPT_GUARD_WINDOW_OVERLAP=512
PROMPT_GUARD_MAX_WINDOWS=32
PROMPT_GUARD_MAX_INPUT_TOKENS=32768
PROMPT_GUARD_MAX_REQUEST_BYTES=1048576
PROMPT_GUARD_DEADLINE_MS=30000
PROMPT_GUARD_QUEUE_SIZE=8

# Optional TLS inside the container. Mount the files read-only.
# PROMPT_GUARD_TLS_CERTFILE=/certs/tls.crt
# PROMPT_GUARD_TLS_KEYFILE=/certs/tls.key
